{
  "name": "space-targets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "prisma generate && next build",
    "lint": "eslint .",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "node scripts/prestart.mjs",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "next": "16.4.6",
    "prisma": "7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "swagger-ui-dist": "5.34.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "overrides": {
    "minimatch": "11.0.8"
  }
}
