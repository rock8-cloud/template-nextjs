generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model SpaceTarget {
  id                 Int      @id @default(autoincrement())
  name               String   @unique
  type               String
  distanceLightYears Float
  description        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
